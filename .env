# Application Settings
APP_TITLE=CourseWeaver
BOOTSTRAP_ADMIN_SECRET=test

# PostgreSQL Database & API Settings
# Defaults for local development (can be configured in Settings UI and persisted in localStorage)
DATABASE_URL=http://localhost:3000/api
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=courseweaver
POSTGRES_USER=courseweaver
POSTGRES_PASSWORD=courseweaver

# OIDC Authentication Settings
# Configure your OIDC Identity Provider (e.g. EduID, docPouch, Keycloak, etc.)
OIDC_ISSUER=http://localhost:3030/oidc
OIDC_CLIENT_ID=courseWeaver.local
OIDC_PROVIDER_NAME=docPouch
OIDC_REGISTRATION_TOKEN=TestToken # Only needed if using docPouch for user auth