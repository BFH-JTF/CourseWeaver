{
  "name": "courseweaver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx src/utils/__tests__/csvImport.test.ts && tsx server/test/api.test.ts",
    "poc:timetable": "tsx server/solver/benchmarks/poc.ts",
    "solver:bench": "tsx server/solver/benchmarks/run.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "cors": "^2.8.6",
    "docpouch-client": "^1.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "or-tools-wasm": "0.9.1",
    "pg": "^8.23.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "~5.7",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^2.2.12"
  }
}
