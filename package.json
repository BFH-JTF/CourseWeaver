{
  "name": "courseweaver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite frontend",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vue-tsc --noEmit -p frontend/tsconfig.json && vite build frontend",
    "preview": "vite preview frontend",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint frontend/src/ --ext .ts,.vue",
    "lint:fix": "eslint frontend/src/ --ext .ts,.vue --fix",
    "test": "tsx --tsconfig frontend/tsconfig.json frontend/src/utils/__tests__/csvImport.test.ts && tsx server/test/api.test.ts && tsx server/test/mapping.test.ts && tsx --tsconfig tsconfig.server.json server/test/coverage.test.ts",
    "seed": "tsx server/seed-mock.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vue/devtools-api": "^8.2.1",
    "cors": "^2.8.6",
    "docpouch-client": "^1.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "tsx": "^4.23.13",
    "typescript": "~5.7",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
