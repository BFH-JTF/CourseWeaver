erDiagram

    DEPARTMENT }|--|{ PROGRAM : "offers"
    PROGRAM }|--|{ DEGREE : "offers"
    DEGREE }|--|{ MODULE : "contains"
    PROGRAM ||--o{ CURRICULUM_VERSION : "has versions"
    CURRICULUM_VERSION ||--o{ CURRICULUM_VERSION : "parents"
    CURRICULUM_VERSION ||--o{ SEMESTER : "used by"
    CURRICULUM_VERSION ||--o{ MODULE : "defines"
    PROGRAM }o--|{ CLASS_ENTITY : "contains"
    SEMESTER }|--o{ CLASS_ENTITY : "applies to"

    MODULE }o--|{ CLASS_ENTITY : "taken by"
    MODULE }|--o{ LECTURER : "taught by"
    MODULE ||--o{ LESSON : "contains"

    LESSON }o--o{ TAXONOMY_ITEM : "categorized by"
    LESSON }o--o{ PROOF_OF_COMPETENCY : "assessed by"

    MODULE }|--o{ COMPETENCY : "develops"
    MODULE }o--o{ PROOF_OF_COMPETENCY : "assessed by"
    PROOF_OF_COMPETENCY }|--o{ COMPETENCY : "evaluates"
    COMPETENCY }o--o| MATRIX_COMPETENCY : "x-axis mapped"
    COMPETENCY }o--o| MATRIX_COMPETENCY : "y-axis mapped"

    LOCATION ||--|{ ROOM : "contains"
    ROOM ||--o{ ROOM_AVAILABILITY : "has"
    LECTURER ||--o{ LECTURER_AVAILABILITY : "has"

    SEMESTER ||--o{ SCHEDULING_RULE : "has"
    SEMESTER ||--|| SEMESTER_SCHEDULE : "has"

    ROOM }|--o{ WEEK_LECTURE : "hosts"
    MODULE }|--o{ WEEK_LECTURE : "teaches"
    SEMESTER_SCHEDULE ||--o{ WEEK_LECTURE : "defines"

    ROOM_AVAILABILITY }|--|{ SEMESTER_SCHEDULE : "informs"
    LECTURER_AVAILABILITY }|--|{ SEMESTER_SCHEDULE : "informs"
    CLASS_ENTITY }|--|{ SEMESTER_SCHEDULE : "informs"
    SCHEDULING_RULE }|--|{ SEMESTER_SCHEDULE : "informs"

    DEPARTMENT {
        string id PK
        string name
        string description
        string contact
        string url
    }

    PROGRAM {
        string id PK
        string name
        string description
        string departmentIds FK
        string degreeType
        number version
        string curriculumVersionId FK
        string contact
        string url
    }

    DEGREE {
        string id PK
        string name
        string description
        string programIds FK
        string contact
        string url
    }

    CURRICULUM_VERSION {
        string id PK
        string name
        string description
        number versionNumber
        string programId FK
        string parentId FK
        string createdAt
    }

    MODULE {
        string id PK
        string name
        string code
        string description
        string degreeIds FK
        string studyProgramIds FK
        string curriculumVersionId FK
        string competencyIds FK
        string proofOfCompetencyIds FK
        number creditPoints
        number contactHours
        number selfStudyHours
        number teachingHours
        string contact
        string url
    }

    CLASS_ENTITY {
        string id PK
        string name
        string code
        string description
        number startingYear
        string semesterId FK
        string programIds FK
        string moduleIds FK
        number size
        string contact
        string url
    }

    LESSON {
        string id PK
        string moduleId FK
        string name
        string description
        string taxonomyItemIds FK
        string proofOfCompetencyIds FK
    }

    TAXONOMY_ITEM {
        string id PK
        string name
        string description
    }

    COMPETENCY {
        string id PK
        string name
        string category
        string topic
        string description
        string level
        boolean matrixDefined
        string xMatrixCompetencyId FK
        string yMatrixCompetencyId FK
    }

    MATRIX_COMPETENCY {
        string id PK
        string name
        string category
        string description
        string level
        string matrixAxis
    }

    PROOF_OF_COMPETENCY {
        string id PK
        string name
        string description
        string assessmentType
        boolean multipleChoice
        boolean freeText
        string assignmentScope
        number durationMinutes
        string competencyIds FK
    }

    LOCATION {
        string id PK
        string name
        string campus
        string building
        string address
        number latitude
        number longitude
    }

    ROOM {
        string id PK
        string name
        string room_type
        string owner
        string location_id FK
        string floor
        string room_number
        json capacity
        json layout
        json equipment
        json connectivity
        json accessibility
        json availability
        json maintenance
    }

    LECTURER {
        string id PK
        string name
        string userId
        string email
        string department
        string moduleIds FK
    }

    LECTURER_AVAILABILITY {
        string id PK
        string lecturerId FK
        string weekday
        string startTime
        string endTime
    }

    ROOM_AVAILABILITY {
        string id PK
        string roomId FK
        string weekday
        string startTime
        string endTime
    }

    SEMESTER {
        string id PK
        string name
        string code
        string startDate
        string endDate
        array daysOff
        string curriculumVersionId FK
        string schedulingRulesId FK
    }

    SCHEDULING_RULE {
        string id PK
        string constraintId
        string category
        number weight
        boolean enabled
        string description
        string semesterId FK
        json params
        array appliesTo
    }

    SEMESTER_SCHEDULE {
        string id PK
        string semesterId FK
    }

    WEEK_LECTURE {
        string id PK
        string moduleIds FK
        string roomId FK
        string weekday
        string startTime
        string endTime
    }
